# Pactix — environment variables

# Database (Supabase PostgreSQL)
DATABASE_URL="postgres://[db-user].[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://[db-user].[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# LLM provider selection: 'gemini' | 'openai' | 'openrouter' | 'ernie' | 'mock'
LLM_PROVIDER="openrouter"

# OpenRouter (Primary) — get a key: https://openrouter.ai/keys
# Recommended for Nemotron / Reasoning models
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# Gemini (Fallback) — get a key: https://aistudio.google.com/apikey
# If the app shows 403 SERVICE_DISABLED: enable "Generative Language API" for the key’s project.
# If the API is already enabled but you still get 403: the key may be from another project, or
# Application restrictions = "HTTP referrers" (breaks Next.js server calls — use None or IP for prod).
# (Aliases also read: GOOGLE_GENERATIVE_AI_API_KEY, GOOGLE_API_KEY)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI (Optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"


# Stripe (test mode keys: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
