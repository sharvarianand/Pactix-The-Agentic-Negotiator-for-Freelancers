# Pactix — environment variables

# Database (SQLite for dev; swap to Postgres later)
DATABASE_URL="file:./dev.db"

# LLM provider selection: 'gemini' | 'openai' | 'ernie' | 'mock'
LLM_PROVIDER="gemini"

# Gemini — get a key: https://aistudio.google.com/apikey
# If the app shows 403 SERVICE_DISABLED: enable "Generative Language API" for the key’s project.
# If the API is already enabled but you still get 403: the key may be from another project, or
# Application restrictions = "HTTP referrers" (breaks Next.js server calls — use None or IP for prod).
# (Aliases also read: GOOGLE_GENERATIVE_AI_API_KEY, GOOGLE_API_KEY)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI (optional fallback)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Baidu ERNIE / Qianfan (optional, for final hackathon swap)
QIANFAN_API_KEY=""
QIANFAN_SECRET_KEY=""
ERNIE_MODEL="ernie-4.5-turbo-128k"

# Stripe (test mode keys: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
