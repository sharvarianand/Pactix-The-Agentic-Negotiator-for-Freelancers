generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Freelancer {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  floorRateHourly   Float
  currency          String   @default("USD")
  stripeAccountId   String?
  voiceStyleSamples String   @default("[]")
  createdAt         DateTime @default(now())
  deals             Deal[]
  connectedAccounts ConnectedAccount[]
}

model ConnectedAccount {
  id           String     @id @default(cuid())
  freelancerId String
  provider     String     // e.g., "google"
  email        String?
  accessToken  String     @db.Text
  refreshToken String?    @db.Text
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, provider])
}

model Client {
  id            String   @id @default(cuid())
  company       String
  contactEmail  String   @unique
  researchCache String?
  firstSeenAt   DateTime @default(now())
  deals         Deal[]
}

model Deal {
  id             String       @id @default(cuid())
  freelancerId   String
  clientId       String
  status         String       @default("new")
  briefText      String
  agreedAmount   Float?
  scope          String?
  winProbability Float?
  gmailThreadId  String?
  createdAt      DateTime     @default(now())
  closedAt       DateTime?
  agentTraces    AgentTrace[]
  contract       Contract?
  client         Client       @relation(fields: [clientId], references: [id])
  freelancer     Freelancer   @relation(fields: [freelancerId], references: [id])
  invoices       Invoice[]
  messages       Message[]

  @@index([status])
  @@index([freelancerId])
  @@index([gmailThreadId])
}

model Message {
  id              String   @id @default(cuid())
  dealId          String
  direction       String
  body            String
  subject         String?
  sentAt          DateTime @default(now())
  approvedByUser  Boolean  @default(false)
  gmailMessageId  String?  @unique
  gmailThreadId   String?
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([gmailThreadId])
}

model AgentTrace {
  id        String   @id @default(cuid())
  dealId    String
  agentName String
  round     Int      @default(1)
  reasoning String
  output    String
  model     String
  latencyMs Int
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([dealId, agentName, round])
}

model Contract {
  id            String    @id @default(cuid())
  dealId        String    @unique
  pdfUrl        String
  scopeSnapshot String
  createdAt     DateTime  @default(now())
  signedAt      DateTime?
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                  String    @id @default(cuid())
  dealId              String
  kind                String
  stripePaymentLink   String
  stripePaymentLinkId String?
  amount              Float
  status              String    @default("pending")
  createdAt           DateTime  @default(now())
  paidAt              DateTime?
  deal                Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([status])
}
